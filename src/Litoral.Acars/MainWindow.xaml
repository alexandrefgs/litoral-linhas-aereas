<Window x:Class="Litoral.Acars.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Litoral ACARS" Width="760" Height="760" MinWidth="680" MinHeight="640"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Litoral ACARS" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}" />
            <TextBlock Text="{Binding SimStatus}" Foreground="{StaticResource Muted}" Margin="0,2,0,12" TextTrimming="CharacterEllipsis" />

            <GroupBox Header="Connection">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Style="{StaticResource Label}" Text="Server address" />
                        <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Style="{StaticResource Label}" Text="ACARS key" />
                        <PasswordBox x:Name="KeyBox" Padding="4,3" />
                        <TextBlock Style="{StaticResource Label}" Margin="0,3,0,0" Text="A key is saved. Paste a new one only to replace it."
                                   Visibility="{Binding HasKey, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <Button Grid.Column="2" VerticalAlignment="Top" Margin="0,17,0,0" Content="Save" Click="Save_Click" />
                </Grid>
            </GroupBox>

            <GroupBox Header="Flight">
                <StackPanel>
                    <TextBlock Text="{Binding BookingText}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Load flight" Command="{Binding LoadBookingCommand}" />
                        <ComboBox ItemsSource="{Binding Networks}" SelectedItem="{Binding SelectedNetwork}" Width="110" Margin="0,0,8,0"
                                  IsEnabled="{Binding FlightStarted, Converter={StaticResource Inverse}}" />
                        <Button Content="Start flight" Command="{Binding StartFlightCommand}" />
                        <Button Content="Demo flight" Command="{Binding DemoFlightCommand}"
                                ToolTip="Records a scripted flight. Only shown for a server on this computer."
                                Visibility="{Binding IsLocalServer, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Live">
                <UniformGrid Columns="6" Rows="2">
                    <StackPanel Margin="0,0,0,8"><TextBlock Style="{StaticResource Label}" Text="Phase" /><TextBlock Style="{StaticResource Value}" Text="{Binding Phase}" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource Label}" Text="IAS" /><TextBlock Style="{StaticResource Value}" Text="{Binding Ias}" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource Label}" Text="Altitude" /><TextBlock Style="{StaticResource Value}" Text="{Binding Altitude}" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource Label}" Text="Ground speed" /><TextBlock Style="{StaticResource Value}" Text="{Binding GroundSpeed}" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource Label}" Text="Vertical speed" /><TextBlock Style="{StaticResource Value}" Text="{Binding VerticalSpeed}" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource Label}" Text="Flaps" /><TextBlock Style="{StaticResource Value}" Text="{Binding Flaps}" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource Label}" Text="Block off" /><TextBlock Style="{StaticResource Value}" Text="{Binding BlockOff}" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource Label}" Text="Takeoff" /><TextBlock Style="{StaticResource Value}" Text="{Binding Takeoff}" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource Label}" Text="Landing" /><TextBlock Style="{StaticResource Value}" Text="{Binding Landing}" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource Label}" Text="Block on" /><TextBlock Style="{StaticResource Value}" Text="{Binding BlockOn}" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource Label}" Text="Touchdown" /><TextBlock Style="{StaticResource Value}" Text="{Binding LandingRate}" /></StackPanel>
                </UniformGrid>
            </GroupBox>
            <TextBlock Text="{Binding SendStatus}" Foreground="{StaticResource Muted}" Margin="0,-4,0,10" />

            <GroupBox Header="PIREP">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource Label}" Text="Arrival (ICAO)" />
                            <TextBox Text="{Binding ArrivalIcao, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" MaxLength="4" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Label}" Text="Comments" />
                            <TextBox Text="{Binding Comments, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Foreground="{StaticResource Danger}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="You parked more than 5 NM from the planned arrival. If you diverted, type the airport where you landed."
                               Visibility="{Binding DiversionWarning, Converter={StaticResource Visible}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="File PIREP" Command="{Binding FilePirepCommand}" />
                        <TextBlock Text="Enabled after block on (parking brake set, stopped)." Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding PirepText}" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                </StackPanel>
            </GroupBox>

            <TextBlock Text="{Binding Status}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</Window>