<Window x:Class="Litoral.Acars.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Litoral ACARS" Icon="Assets/litoral.ico"
        Width="840" Height="900" MinWidth="740" MinHeight="680"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource Page}" Foreground="{StaticResource Ink}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Navy}" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Viewbox Width="40" Height="40" VerticalAlignment="Center">
                    <Canvas Width="64" Height="64">
                        <Canvas.Clip>
                            <RectangleGeometry Rect="0,0,64,64" RadiusX="14" RadiusY="14" />
                        </Canvas.Clip>
                        <Rectangle Width="64" Height="64" Fill="#1D6FD8" />
                        <Ellipse Canvas.Left="38" Canvas.Top="12" Width="14" Height="14" Fill="#FFD166" />
                        <Path Data="M17,12 H26 V38 H44 V46 H17 Z" Fill="White" />
                        <Path Data="M0,52 Q8,46 16,52 T32,52 T48,52 T64,52 V64 H0 Z" Fill="#2EC4B6" />
                    </Canvas>
                </Viewbox>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Litoral ACARS" FontSize="20" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Litoral Linhas Aéreas · v0.1" FontSize="12" Foreground="{StaticResource NavyMuted}" />
                </StackPanel>

                <Border Grid.Column="2" Background="{StaticResource NavySoft}" CornerRadius="16" Padding="12,6" VerticalAlignment="Center" MaxWidth="360">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource NavyMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SimConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding SimStatus}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="20,10" BorderThickness="0,1,0,0"
                Visibility="{Binding HasStatus, Converter={StaticResource Visible}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource DangerSoft}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Ink}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,18,20,6">

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}" Text="CONNECTION" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource Label}" Text="Server address" />
                                <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource Label}" Text="ACARS key" />
                                <PasswordBox x:Name="KeyBox" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Margin="0" VerticalAlignment="Bottom"
                                    Content="Save" Click="Save_Click" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="A key is saved. Paste a new one only to replace it. Create keys in Settings › ACARS keys on the website."
                                   Visibility="{Binding HasKey, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}" Text="FLIGHT" />

                        <TextBlock Text="{Binding BookingText}" Margin="0,0,0,14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFlight}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid Margin="0,0,0,16" Visibility="{Binding HasFlight, Converter={StaticResource Visible}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.ColumnSpan="3" Text="{Binding Callsign}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Primary}" HorizontalAlignment="Center" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="1" Text="{Binding Departure}" FontSize="28" FontWeight="Bold" />
                            <Grid Grid.Row="1" Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                <Rectangle Height="1" Stroke="{StaticResource Line}" StrokeThickness="1" StrokeDashArray="4 3" VerticalAlignment="Center" />
                                <Border Background="{StaticResource Surface}" Padding="8,0" HorizontalAlignment="Center">
                                    <TextBlock Text="✈" FontFamily="Segoe UI Symbol" FontSize="20" Foreground="{StaticResource Primary}" />
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Arrival}" FontSize="28" FontWeight="Bold" />

                            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding AircraftText}" Foreground="{StaticResource Muted}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </Grid>

                        <TextBlock Style="{StaticResource Label}" Text="Network" />
                        <ListBox Style="{StaticResource Chips}" ItemsSource="{Binding Networks}" SelectedItem="{Binding SelectedNetwork}"
                                 IsEnabled="{Binding FlightStarted, Converter={StaticResource Inverse}}" Margin="0,0,0,16" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Load flight" Command="{Binding LoadBookingCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Start flight" Command="{Binding StartFlightCommand}" />
                            <Button Content="Demo flight" Command="{Binding DemoFlightCommand}"
                                    ToolTip="Records a scripted flight. Only shown for a server on this computer."
                                    Visibility="{Binding IsLocalServer, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoft}" CornerRadius="12" Padding="10,3">
                                <TextBlock Text="{Binding Phase}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OnAccent}" />
                            </Border>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="LIVE" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>

                        <UniformGrid Columns="5" Margin="0,0,-8,0">
                            <Border Style="{StaticResource Tile}">
                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="IAS" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding Ias}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Altitude" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding Altitude}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Ground speed" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding GroundSpeed}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Vertical speed" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding VerticalSpeed}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Flaps" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding Flaps}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Block off" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding BlockOff}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Takeoff" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding Takeoff}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Landing" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding Landing}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Block on" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding BlockOn}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Touchdown" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding LandingRate}" /></StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Style="{StaticResource Hint}" Text="{Binding SendStatus}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}" Text="PIREP" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource Label}" Text="Arrival (ICAO)" />
                                <TextBox Text="{Binding ArrivalIcao, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" MaxLength="4"
                                         FontFamily="Consolas" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Label}" Text="Comments" />
                                <TextBox Text="{Binding Comments, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource HighlightSoft}" BorderBrush="{StaticResource HighlightLine}" BorderThickness="1"
                                CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                                Visibility="{Binding DiversionWarning, Converter={StaticResource Visible}}">
                            <TextBlock Foreground="{StaticResource OnHighlight}" TextWrapping="Wrap"
                                       Text="You parked more than 5 NM from the planned arrival. If you diverted, type the airport where you landed." />
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="File PIREP" Command="{Binding FilePirepCommand}" />
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                       Text="Enabled after block on: aircraft stopped with the parking brake set." />
                        </StackPanel>

                        <Border Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="12,10" Margin="0,14,0,0"
                                Visibility="{Binding HasPirep, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding PirepText}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource OnAccent}" />
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>