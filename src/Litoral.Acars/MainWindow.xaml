<Window x:Class="Litoral.Acars.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Litoral ACARS" Icon="Assets/litoral.ico"
        Width="1080" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Root">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource Header}" Height="64">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Viewbox Width="38" Height="38" Margin="18,0,0,0" VerticalAlignment="Center">
                        <Canvas Width="64" Height="64">
                            <Canvas.Clip>
                                <RectangleGeometry Rect="0,0,64,64" RadiusX="14" RadiusY="14" />
                            </Canvas.Clip>
                            <Rectangle Width="64" Height="64" Fill="#1D6FD8" />
                            <Ellipse Canvas.Left="38" Canvas.Top="12" Width="14" Height="14" Fill="#FFD166" />
                            <Path Data="M17,12 H26 V38 H44 V46 H17 Z" Fill="White" />
                            <Path Data="M0,52 Q8,46 16,52 T32,52 T48,52 T64,52 V64 H0 Z" Fill="#2EC4B6" />
                        </Canvas>
                    </Viewbox>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Litoral ACARS" FontSize="19" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Litoral Linhas Aéreas · v0.1" FontSize="11" Foreground="{DynamicResource HeaderMuted}" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="{DynamicResource HeaderSoft}" CornerRadius="16" Padding="12,6" Margin="0,0,12,0"
                            VerticalAlignment="Center" MaxWidth="380">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource HeaderMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SimConnected}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding SimStatus}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="3" Style="{StaticResource ChromeButton}" Height="36" Width="40" FontSize="15" Margin="0,0,8,0"
                            Command="{Binding ToggleThemeCommand}" VerticalAlignment="Center">
                        <Button.Content>
                            <TextBlock FontFamily="{StaticResource Icons}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE708;" />
                                        <Setter Property="ToolTip" Value="Dark mode" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDark}" Value="True">
                                                <Setter Property="Text" Value="&#xE706;" />
                                                <Setter Property="ToolTip" Value="Light mode" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" ToolTip="Minimize" Click="Minimize_Click" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" ToolTip="Maximize" Click="Maximize_Click" />
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="20,10" BorderThickness="0,1,0,0"
                    Visibility="{Binding HasStatus, Converter={StaticResource Visible}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <Border DockPanel.Dock="Left" Width="210" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="22,0,16,16"
                               Text="Positions are sent every 30 seconds while a flight is in progress." />
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource Eyebrow}" Text="MENU" Margin="22,0,0,8" />
                        <RadioButton Style="{StaticResource NavItem}" Content="Flight" Tag="&#xE709;"
                                     IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource PageIs}, ConverterParameter=Flight}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Flight" />
                        <RadioButton Style="{StaticResource NavItem}" Content="Briefing" Tag="&#xE8A5;"
                                     IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource PageIs}, ConverterParameter=Briefing}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Briefing" />
                        <RadioButton Style="{StaticResource NavItem}" Content="Live map" Tag="&#xE707;"
                                     IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource PageIs}, ConverterParameter=LiveMap}"
                                     Command="{Binding NavigateCommand}" CommandParameter="LiveMap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding Page, Converter={StaticResource PageVisible}, ConverterParameter=Flight}">
                    <StackPanel Margin="20,18,20,6">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Eyebrow}" Text="CONNECTION" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource Label}" Text="Server address" />
                                        <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource Label}" Text="ACARS key" />
                                        <PasswordBox x:Name="KeyBox" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Margin="0" VerticalAlignment="Bottom"
                                            Content="Save" Click="Save_Click" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="A key is saved. Paste a new one only to replace it. Create keys in Settings › ACARS keys on the website."
                                           Visibility="{Binding HasKey, Converter={StaticResource Visible}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Eyebrow}" Text="FLIGHT" />

                                <TextBlock Text="{Binding BookingText}" Margin="0,0,0,14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFlight}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Grid Margin="0,0,0,16" Visibility="{Binding HasFlight, Converter={StaticResource Visible}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.ColumnSpan="3" Text="{Binding Callsign}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Primary}" HorizontalAlignment="Center" Margin="0,0,0,6" />

                                    <TextBlock Grid.Row="1" Text="{Binding Departure}" FontSize="28" FontWeight="Bold" />
                                    <Grid Grid.Row="1" Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                        <Rectangle Height="1" Stroke="{DynamicResource Line}" StrokeThickness="1" StrokeDashArray="4 3" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource Surface}" Padding="8,0" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE709;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{DynamicResource Primary}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Arrival}" FontSize="28" FontWeight="Bold" />

                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding AircraftText}" Foreground="{DynamicResource Muted}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                                </Grid>

                                <TextBlock Style="{StaticResource Label}" Text="Network" />
                                <ListBox Style="{StaticResource Chips}" ItemsSource="{Binding Networks}" SelectedItem="{Binding SelectedNetwork}"
                                         IsEnabled="{Binding FlightStarted, Converter={StaticResource Inverse}}" Margin="0,0,0,16" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Load flight" Command="{Binding LoadBookingCommand}" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="Start flight" Command="{Binding StartFlightCommand}" />
                                    <Button Content="Demo flight" Command="{Binding DemoFlightCommand}"
                                            ToolTip="Records a scripted flight. Only shown for a server on this computer."
                                            Visibility="{Binding IsLocalServer, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Badge}">
                                        <TextBlock Text="{Binding Phase}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnAccent}" />
                                    </Border>
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="LIVE" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>

                                <UniformGrid Columns="5" Margin="0,0,-8,0">
                                    <Border Style="{StaticResource Tile}">
                                        <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="IAS" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding Ias}" /></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Tile}">
                                        <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Altitude" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding Altitude}" /></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Tile}">
                                        <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Ground speed" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding GroundSpeed}" /></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Tile}">
                                        <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Vertical speed" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding VerticalSpeed}" /></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Tile}">
                                        <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Flaps" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding Flaps}" /></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Tile}">
                                        <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Block off" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding BlockOff}" /></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Tile}">
                                        <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Takeoff" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding Takeoff}" /></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Tile}">
                                        <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Landing" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding Landing}" /></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Tile}">
                                        <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Block on" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding BlockOn}" /></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Tile}">
                                        <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Touchdown" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding LandingRate}" /></StackPanel>
                                    </Border>
                                </UniformGrid>

                                <TextBlock Style="{StaticResource Hint}" Text="{Binding SendStatus}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Eyebrow}" Text="PIREP" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource Label}" Text="Arrival (ICAO)" />
                                        <TextBox Text="{Binding ArrivalIcao, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" MaxLength="4"
                                                 FontFamily="Consolas" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource Label}" Text="Comments" />
                                        <TextBox Text="{Binding Comments, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" />
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource HighlightSoft}" BorderBrush="{DynamicResource HighlightLine}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                                        Visibility="{Binding DiversionWarning, Converter={StaticResource Visible}}">
                                    <TextBlock Foreground="{DynamicResource OnHighlight}" TextWrapping="Wrap"
                                               Text="You parked more than 5 NM from the planned arrival. If you diverted, type the airport where you landed." />
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="File PIREP" Command="{Binding FilePirepCommand}" />
                                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                               Text="Enabled after block on: aircraft stopped with the parking brake set." />
                                </StackPanel>

                                <Border Style="{StaticResource Badge}" CornerRadius="8" Padding="12,10" Margin="0,14,0,0"
                                        Visibility="{Binding HasPirep, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{Binding PirepText}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource OnAccent}" />
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Briefing}"
                              Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=Briefing}">
                    <StackPanel Margin="20,18,20,6">

                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBriefing}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Refresh" Margin="0" Command="{Binding RefreshCommand}" />
                                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <StackPanel Visibility="{Binding HasBriefing, Converter={StaticResource Visible}}">

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Content="Refresh" Margin="0" Command="{Binding RefreshCommand}" />
                                        <TextBlock Style="{StaticResource Eyebrow}" Text="BRIEFING" Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.ColumnSpan="3" Text="{Binding Briefing.Booking.Callsign}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Primary}" HorizontalAlignment="Center" Margin="0,0,0,6" />

                                        <StackPanel Grid.Row="1">
                                            <TextBlock Text="{Binding Briefing.Booking.Departure.Icao}" FontSize="28" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Briefing.Booking.Departure.City}" Foreground="{DynamicResource Muted}" />
                                        </StackPanel>
                                        <Grid Grid.Row="1" Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                            <Rectangle Height="1" Stroke="{DynamicResource Line}" StrokeThickness="1" StrokeDashArray="4 3" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource Surface}" Padding="8,0" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DistanceText}" FontWeight="SemiBold" Foreground="{DynamicResource Primary}" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Briefing.Booking.Arrival.Icao}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding Briefing.Booking.Arrival.City}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>

                                    <UniformGrid Columns="4" Margin="0,16,-8,0">
                                        <Border Style="{StaticResource Tile}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource StatLabel}" Text="Aircraft" />
                                                <TextBlock Style="{StaticResource StatValue}" FontSize="14" Text="{Binding Briefing.Booking.Aircraft.Registration}" />
                                                <TextBlock Style="{StaticResource Hint}" Text="{Binding Briefing.Booking.Aircraft.TypeName}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Tile}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource StatLabel}" Text="Captain" />
                                                <TextBlock Style="{StaticResource StatValue}" FontSize="14" Text="{Binding CaptainText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Tile}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource StatLabel}" Text="First Officer" />
                                                <TextBlock Style="{StaticResource StatValue}" FontSize="14" Text="{Binding FirstOfficerText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Tile}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource StatLabel}" Text="Network callsign if taken" />
                                                <TextBlock Style="{StaticResource StatValue}" FontSize="14" Text="{Binding Briefing.Booking.NetworkCallsign}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="FLIGHT PLAN" />
                                    <TextBlock Style="{StaticResource Label}" Text="Item 18 must include" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding CopyRemarksCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Content" Value="Copy" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Copied}" Value="True">
                                                            <Setter Property="Content" Value="Copied" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Border Style="{StaticResource CodeBox}">
                                            <TextBlock Style="{StaticResource Mono}" FontWeight="SemiBold" Text="{Binding Briefing.FlightPlanRemarks}" />
                                        </Border>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Content="Prefile on VATSIM" Command="{Binding OpenVatsimCommand}" />
                                        <Button Style="{StaticResource PrimaryButton}" Content="Prefile on IVAO" Command="{Binding OpenIvaoCommand}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                               Text="With a SimBrief OFP for this flight, the prefile opens filled in, with item 18 already corrected. Check it before sending." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="WEATHER" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}">
                                                    <TextBlock Text="{Binding DepartureWeather.Category, FallbackValue=—, TargetNullValue=—}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnAccent}" />
                                                </Border>
                                                <TextBlock Text="{Binding Briefing.Booking.Departure.Icao}" FontSize="16" FontWeight="Bold" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8">
                                                <Run Text="Wind " /><Run Text="{Binding DepartureWind, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="  ·  QNH " /><Run Text="{Binding DepartureWeather.QnhHpa, Mode=OneWay, TargetNullValue=—}" FontWeight="SemiBold" />
                                                <Run Text="  ·  Vis " /><Run Text="{Binding DepartureWeather.Visibility, Mode=OneWay, TargetNullValue=—}" FontWeight="SemiBold" />
                                            </TextBlock>
                                            <Border Style="{StaticResource CodeBox}" Margin="0,0,0,8">
                                                <TextBlock Style="{StaticResource Mono}" Text="{Binding DepartureWeather.Raw, FallbackValue=No METAR, TargetNullValue=No METAR}" />
                                            </Border>
                                            <Border Style="{StaticResource CodeBox}">
                                                <TextBlock Style="{StaticResource Mono}" Text="{Binding DepartureWeather.Taf, FallbackValue=No TAF, TargetNullValue=No TAF}" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <DockPanel Margin="0,0,0,8">
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}">
                                                    <TextBlock Text="{Binding ArrivalWeather.Category, FallbackValue=—, TargetNullValue=—}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnAccent}" />
                                                </Border>
                                                <TextBlock Text="{Binding Briefing.Booking.Arrival.Icao}" FontSize="16" FontWeight="Bold" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8">
                                                <Run Text="Wind " /><Run Text="{Binding ArrivalWind, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="  ·  QNH " /><Run Text="{Binding ArrivalWeather.QnhHpa, Mode=OneWay, TargetNullValue=—}" FontWeight="SemiBold" />
                                                <Run Text="  ·  Vis " /><Run Text="{Binding ArrivalWeather.Visibility, Mode=OneWay, TargetNullValue=—}" FontWeight="SemiBold" />
                                            </TextBlock>
                                            <Border Style="{StaticResource CodeBox}" Margin="0,0,0,8">
                                                <TextBlock Style="{StaticResource Mono}" Text="{Binding ArrivalWeather.Raw, FallbackValue=No METAR, TargetNullValue=No METAR}" />
                                            </Border>
                                            <Border Style="{StaticResource CodeBox}">
                                                <TextBlock Style="{StaticResource Mono}" Text="{Binding ArrivalWeather.Taf, FallbackValue=No TAF, TargetNullValue=No TAF}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="SIMBRIEF OFP" />
                                    <TextBlock Text="{Binding OfpMessage}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasOfp}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel Visibility="{Binding HasOfp, Converter={StaticResource Visible}}">
                                        <UniformGrid Columns="4" Margin="0,0,-8,0">
                                            <Border Style="{StaticResource Tile}">
                                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Cruise" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding CruiseText}" /></StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Tile}">
                                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Cost index" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding Ofp.CostIndex, TargetNullValue=—}" /></StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Tile}">
                                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Alternate" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding Ofp.Alternate, TargetNullValue=—}" /></StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Tile}">
                                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Runways (dep / arr)" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding RunwaysText}" /></StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Tile}">
                                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Enroute time" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding EnrouteText}" /></StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Tile}">
                                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Block fuel" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding BlockFuelText}" /></StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Tile}">
                                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Trip fuel" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding TripFuelText}" /></StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Tile}">
                                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="AIRAC" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding Ofp.Airac, TargetNullValue=—}" /></StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Tile}">
                                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Passengers" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding Ofp.Loadsheet.Passengers, TargetNullValue=—}" /></StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Tile}">
                                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Zero fuel weight" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding ZfwText}" /></StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Tile}">
                                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Takeoff weight" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding TowText}" /></StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Tile}">
                                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="Landing weight" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding LwText}" /></StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <TextBlock Style="{StaticResource Label}" Text="Route" Margin="0,6,0,4" />
                                        <Border Style="{StaticResource CodeBox}">
                                            <TextBlock Style="{StaticResource Mono}" Text="{Binding Ofp.Route, TargetNullValue=—}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid Visibility="{Binding Page, Converter={StaticResource PageVisible}, ConverterParameter=LiveMap}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="20,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Refresh" Margin="0" Command="{Binding LiveMap.RefreshCommand}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Eyebrow}" Text="LIVE MAP" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding LiveMap.Summary}" Foreground="{DynamicResource Muted}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <wv2:WebView2 x:Name="MapView" Grid.Row="1" />
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>